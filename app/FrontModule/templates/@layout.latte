<!doctype html>
<html lang="{$lang}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="theme-color" content="#f6f5f2">
	<meta name="description" content="{ifset $metaDescription}{$metaDescription}{else}{if $lang === 'en'}Construction, renovation and modernisation by TIARA s.r.o.{else}Výstavba, rekonstrukce a modernizace od TIARA s.r.o.{/if}{/ifset}">
	<meta name="robots" content="{ifset $robots}{$robots}{else}index,follow{/ifset}">
	{ifset $metaTitle}<title>{$metaTitle}</title>{else}<title>{ifset $pageTitle}{$pageTitle} · {/ifset}TIARA s.r.o. — {if $lang === 'en'}Construction{else}Stavební práce{/if}</title>{/ifset}
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="TIARA s.r.o.">
	<meta property="og:title" content="{ifset $ogTitle}{$ogTitle}{else}TIARA s.r.o.{/ifset}">
	<meta property="og:description" content="{ifset $ogDescription}{$ogDescription}{else}Stavební práce TIARA s.r.o.{/ifset}">
	{ifset $ogImage}<meta property="og:image" content="{$ogImage}">{/ifset}
	{ifset $canonical}<link rel="canonical" href="{$canonical}">{/ifset}
	<link rel="icon" href="/favicon.svg" type="image/svg+xml">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/20bU0F7VyyEwFjM4xAz8TwR4w8G3q6n9rV2Xf7+qU38rY8w0q4z7m1U6A==" crossorigin="anonymous" referrerpolicy="no-referrer">
	<link rel="stylesheet" href="/css/app.css">
	<link rel="preload" as="image" href="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=85" imagesrcset="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=80 1200w, https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=85 2000w">
	<script type="application/ld+json">{"@context":"https://schema.org","@type":"GeneralContractor","name":"TIARA s.r.o.","description":"Komplexní stavební práce, výstavba, rekonstrukce a modernizace.","telephone":"{$company['phone'] ?? '+420 777 123 456'}","email":"{$company['email'] ?? 'info@tiara-stavby.cz'}","address":{"@type":"PostalAddress","streetAddress":"{$company['address'] ?? 'Praha, Česká republika'}","addressCountry":"CZ"},"url":"https://tiara-stavby.cz"}</script>
</head>
<body>
	<a class="skip-link" href="#main">{if $lang === 'en'}Skip to content{else}Přejít na obsah{/if}</a>
	<div class="topline"><div class="container topline__inner"><span>{if $lang === 'en'}Thoughtful building. Lasting value.{else}Stavíme promyšleně. S hodnotou na dlouhá léta.{/if}</span><div><a href="tel:{$company['phone'] ?? '+420777123456'}"><i class="fa-solid fa-phone"></i> {$company['phone'] ?? '+420 777 123 456'}</a><span class="topline__separator"></span><a class="language-switch" href="{if $lang === 'en'}/cs/{else}/en/{/if}" hreflang="{if $lang === 'en'}cs{else}en{/if}">{if $lang === 'en'}CZ{else}EN{/if}</a></div></div></div>
	<header class="site-header" data-header>
		<div class="container header__inner">
			<a class="brand" href="{if $lang === 'en'}/en/{else}/cs/{/if}" aria-label="TIARA s.r.o. — home"><img src="/images/tiara-logo.svg" width="206" height="60" alt="TIARA s.r.o. — VEŠKERÉ STAVEBNÍ PRÁCE"></a>
			<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation"><span></span><span></span><span></span><span class="sr-only">Menu</span></button>
			<nav class="main-nav" id="primary-navigation" aria-label="{if $lang === 'en'}Main navigation{else}Hlavní navigace{/if}">
				{foreach $navigationItems as $item}<a href="{$item['url']}" class="nav-link">{$item['title']}</a>{/foreach}
			</nav>
			<a class="button button--small button--navy header__cta" href="{if $lang === 'en'}/en/contact{else}/cs/kontakt{/if}">{if $lang === 'en'}Request a quote{else}Nezávazná poptávka{/if}<i class="fa-solid fa-arrow-right"></i></a>
		</div>
	</header>
	<main id="main">{include content}</main>
	<footer class="site-footer">
		<div class="container footer__main">
			<div class="footer__brand"><a href="{if $lang === 'en'}/en/{else}/cs/{/if}"><img src="/images/tiara-logo-light.svg" width="206" height="60" alt="TIARA s.r.o."></a><p>{if $lang === 'en'}Construction, renovation and modernisation with quality you can rely on.{else}Výstavba, rekonstrukce a modernizace s kvalitou, na kterou se můžete spolehnout.{/if}</p></div>
			<div><span class="footer__label">{if $lang === 'en'}Explore{else}Prozkoumejte{/if}</span><div class="footer__links"><a href="{if $lang === 'en'}/en/about{else}/cs/o-nas{/if}">{$labels['about']}</a><a href="{if $lang === 'en'}/en/services{else}/cs/sluzby{/if}">{$labels['services']}</a><a href="{if $lang === 'en'}/en/projects{else}/cs/realizace{/if}">{$labels['projects']}</a></div></div>
			<div><span class="footer__label">TIARA s.r.o.</span><div class="footer__links"><a href="tel:{$company['phone'] ?? '+420777123456'}">{$company['phone'] ?? '+420 777 123 456'}</a><a href="mailto:{$company['email'] ?? 'info@tiara-stavby.cz'}">{$company['email'] ?? 'info@tiara-stavby.cz'}</a><span>{$company['address'] ?? 'Praha, Česká republika'}</span></div></div>
			<div class="footer__contact"><span class="footer__label">{if $lang === 'en'}Have a project in mind?{else}Máte projekt v plánu?{/if}</span><a class="footer__arrow" href="{if $lang === 'en'}/en/contact{else}/cs/kontakt{/if}">{$labels['contactUs']} <i class="fa-solid fa-arrow-right"></i></a></div>
		</div>
		<div class="container footer__bottom"><span>© {date('Y')} TIARA s.r.o.</span><span>{if $lang === 'en'}All rights reserved.{else}Všechna práva vyhrazena.{/if}</span><a href="/sitemap.xml">Sitemap</a></div>
	</footer>
	<script src="/js/site.js" defer></script>
</body>
</html>
