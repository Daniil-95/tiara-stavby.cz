<!doctype html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="theme-color" content="#f6f5f2">
	<meta name="description" content="{ifset $metaDescription}{$metaDescription}{else}Výstavba, rekonstrukce a modernizace od TIARA s.r.o.{/ifset}">
	{ifset $metaKeywords}{if $metaKeywords !== ''}<meta name="keywords" content="{$metaKeywords}">{/if}{/ifset}
	<meta name="robots" content="{ifset $robots}{$robots}{else}index,follow{/ifset}">
	{ifset $metaTitle}<title>{$metaTitle}</title>{else}<title>{ifset $pageTitle}{$pageTitle} · {/ifset}TIARA s.r.o. — Stavební práce</title>{/ifset}
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="TIARA s.r.o.">
	<meta property="og:title" content="{ifset $ogTitle}{$ogTitle}{else}TIARA s.r.o.{/ifset}">
	<meta property="og:description" content="{ifset $ogDescription}{$ogDescription}{else}Stavební práce TIARA s.r.o.{/ifset}">
	{ifset $ogImage}<meta property="og:image" content="{$ogImage}">{/ifset}
	{ifset $canonical}<link rel="canonical" href="{$canonical}">{/ifset}
	<link rel="icon" href="/favicon.svg" type="image/svg+xml">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
	<link rel="stylesheet" href="/css/app.css">
	{if $currentPath === '/'}<link rel="preload" as="image" href="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=85" imagesrcset="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=80 1200w, https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=85 2000w">{/if}
	<script type="application/ld+json">{$jsonLd|noescape}</script>
</head>
<body>
	<a class="skip-link" href="#main">Přejít na obsah</a>
	<div class="topline"><div class="container topline__inner"><span>Stavíme promyšleně. S hodnotou na dlouhá léta.</span><div><a href="tel:{$company['phone'] ?? '+420000000000'}"><i class="fa-solid fa-phone"></i> {$company['phone'] ?? '+420 000 000 000'}</a></div></div></div>
	<header class="site-header" data-header>
		<div class="container header__inner">
			<a class="brand" href="/" aria-label="TIARA s.r.o. — domů"><img src="/images/tiara-logo.svg" width="206" height="60" alt="TIARA s.r.o. — VEŠKERÉ STAVEBNÍ PRÁCE"></a>
			<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation"><span></span><span></span><span></span><span class="sr-only">Menu</span></button>
			<nav class="main-nav" id="primary-navigation" aria-label="Hlavní navigace">
				{foreach $navigationItems as $item}{var $isActive = $activeNavigation[$item['id']] ?? false}<a href="{$item['url']}" class="nav-link {if $isActive}is-active{/if}" {if $isActive}aria-current="page"{/if}>{$item['title']}</a>{/foreach}
				<a href="/admin" class="nav-link nav-link--admin" aria-label="Administrace" title="Administrace"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i></a>
			</nav>
			<a class="button button--small button--navy header__cta" href="{$company['header_cta_url'] ?? '/kontakt'}" aria-label="{$company['header_cta_label'] ?? 'Nezávazná poptávka'}"><span>{$company['header_cta_label'] ?? 'Nezávazná poptávka'}</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
		</div>
	</header>
	{foreach $flashes as $flash}<div class="site-flash site-flash--{$flash->type}" role="status">{$flash->message}</div>{/foreach}
	<main id="main">{include content}</main>
	<footer class="site-footer">
		<div class="container footer__main">
			<div class="footer__brand"><a href="/"><img src="/images/tiara-logo-light.svg" width="206" height="60" alt="TIARA s.r.o."></a><p>Výstavba, rekonstrukce a modernizace s kvalitou, na kterou se můžete spolehnout.</p></div>
			<div><span class="footer__label">Prozkoumejte</span><div class="footer__links"><a href="/o-nas">{$labels['about']}</a><a href="/sluzby">{$labels['services']}</a><a href="/realizace">{$labels['projects']}</a></div></div>
			<div><span class="footer__label">TIARA s.r.o.</span><div class="footer__links"><a href="tel:{$company['phone'] ?? '+420000000000'}">{$company['phone'] ?? '+420 000 000 000'}</a><a href="mailto:{$company['email'] ?? 'info@tiara-stavby.cz'}">{$company['email'] ?? 'info@tiara-stavby.cz'}</a><span>{$company['address'] ?? 'Česká republika'}</span></div></div>
			<div class="footer__contact"><span class="footer__label">Máte projekt v plánu?</span><a class="footer__arrow" href="/kontakt">{$labels['contactUs']} <i class="fa-solid fa-arrow-right"></i></a></div>
		</div>
		{if $company['facebook'] || $company['instagram'] || $company['linkedin'] || $company['ico'] || $company['dic']}<div class="container footer__extras"><div class="footer__social" aria-label="Sociální sítě">{if str_starts_with((string) $company['facebook'], 'https://')}<a href="{$company['facebook']}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>{/if}{if str_starts_with((string) $company['instagram'], 'https://')}<a href="{$company['instagram']}" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>{/if}{if str_starts_with((string) $company['linkedin'], 'https://')}<a href="{$company['linkedin']}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a>{/if}</div><p class="footer__legal">{if $company['ico']}IČO: {$company['ico']}{/if}{if $company['dic']} DIČ: {$company['dic']}{/if}</p></div>{/if}
		<div class="container footer__bottom"><span>© {date('Y')} TIARA s.r.o.</span><span>Všechna práva vyhrazena.</span><a href="/sitemap.xml">Sitemap</a></div>
	</footer>
	<script src="/js/site.js" defer></script>
</body>
</html>
