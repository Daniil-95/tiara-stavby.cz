{block content}
<section class="page-hero page-hero--light"><div class="container page-hero__inner"><div><p class="eyebrow">TIARA s.r.o. / {if $lang === 'en'}CONTACT{else}KONTAKT{/if}</p><h1>{if $lang === 'en'}Let’s talk about<br><em>what comes next.</em>{else}Pojďme probrat,<br><em>co bude dál.</em>{/if}</h1><p class="page-hero__lead">{if $lang === 'en'}A first conversation costs nothing. Share your plans and we will help you find the right next step.{else}Úvodní konzultace vás k ničemu nezavazuje. Řekněte nám, co plánujete, a společně najdeme další krok.{/if}</p></div><div class="page-hero__number"><i class="fa-regular fa-paper-plane"></i></div></div></section>
<section class="contact-page section-space"><div class="container contact-page__grid"><div class="contact-page__details"><p class="eyebrow">{if $lang === 'en'}GET IN TOUCH{else}OZVĚTE SE NÁM{/if}</p><h2>{if $lang === 'en'}Here when<br>you need us.{else}Jsme tu,<br>když nás potřebujete.{/if}</h2><div class="contact-details contact-details--large"><a href="tel:{$company['phone'] ?? '+420777123456'}"><span class="contact-details__icon"><i class="fa-solid fa-phone"></i></span><span><small>{$labels['phone']}</small><strong>{$company['phone'] ?? '+420 777 123 456'}</strong></span></a><a href="mailto:{$company['email'] ?? 'info@tiara-stavby.cz'}"><span class="contact-details__icon"><i class="fa-regular fa-envelope"></i></span><span><small>{$labels['email']}</small><strong>{$company['email'] ?? 'info@tiara-stavby.cz'}</strong></span></a><div><span class="contact-details__icon"><i class="fa-solid fa-location-dot"></i></span><span><small>{$labels['address']}</small><strong>{$company['address'] ?? 'Praha, Česká republika'}</strong></span></div><div><span class="contact-details__icon"><i class="fa-regular fa-clock"></i></span><span><small>{$labels['hours']}</small><strong>{$company['hours'] ?? 'Po–Pá 8:00–17:00'}</strong></span></div></div><div class="contact-photo"><img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1100&q=78" width="900" height="500" alt="Moderní městská architektura" loading="lazy"></div></div><div class="contact-form-wrap contact-form-wrap--page"><div class="contact-form-wrap__top"><span>{if $lang === 'en'}Tell us about your project{else}Napište nám o svém projektu{/if}</span><i class="fa-solid fa-arrow-down-long"></i></div>{control inquiryForm}</div></div></section>
{/block}
