{block content}
<section class="page-hero page-hero--light"><div class="container page-hero__inner"><div><p class="eyebrow">TIARA s.r.o. / {if $lang === 'en'}GALLERY{else}REFERENCE{/if}</p><h1>{if $lang === 'en'}Spaces shaped<br><em>around life.</em>{else}Prostory pro<br><em>skutečný život.</em>{/if}</h1><p class="page-hero__lead">{if $lang === 'en'}Homes and workplaces, transformed with care and craft.{else}Domovy a místa pro práci, proměněná s péčí a řemeslnou poctivostí.{/if}</p></div></div></section>
<section class="reference-gallery section-space"><div class="container reference-gallery__grid">{foreach $projects as $index => $project}{var $galleryFallback = 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1300&q=82'}<a class="reference-tile reference-tile--{$index % 4 + 1}" href="{if $lang === 'en'}/en/projects/{$project['id']}{else}/cs/realizace/{$project['id']}{/if}" data-reveal><img src="{$imageManager->safeUrl($project['main_image'], $galleryFallback)}" srcset="{$imageManager->srcSet($project['main_image'], $galleryFallback)}" sizes="(max-width: 600px) 50vw, 50vw" width="1000" height="800" alt="{$project['title']}" loading="lazy"><span class="reference-tile__caption"><small>{$project['category']} · {$project['year']}</small><strong>{$project['title']}</strong></span><span class="reference-tile__arrow"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a>{/foreach}</div></section>
{/block}
