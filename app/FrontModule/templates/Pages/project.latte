{block content}
<section class="detail-hero detail-hero--project"><img src="{$project['main_image'] ?: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2200&q=84'}" width="2000" height="1180" alt="{$project['title']} — {$project['location']}" fetchpriority="high"><div class="detail-hero__overlay"></div><div class="container detail-hero__content"><a class="back-link" href="{if $lang === 'en'}/en/projects{else}/cs/realizace{/if}"><i class="fa-solid fa-arrow-left"></i> {$labels['back']}</a><p class="eyebrow eyebrow--light">{$project['category']} · {$project['year']}</p><h1>{$project['title']}</h1><p>{$project['location']}</p></div></section>
<section class="project-story section-space"><div class="container project-story__grid"><div><p class="eyebrow">{if $lang === 'en'}PROJECT OVERVIEW{else}O REALIZACI{/if}</p><h2>{if $lang === 'en'}Details make<br><em>the difference.</em>{else}Na detailech<br><em>záleží.</em>{/if}</h2></div><div><p class="lead">{$project['short_description']}</p><p>{$project['description']}</p><dl class="project-facts"><div><dt>{$labels['category']}</dt><dd>{$project['category']}</dd></div><div><dt>{$labels['location']}</dt><dd>{$project['location']}</dd></div><div><dt>{$labels['year']}</dt><dd>{$project['year']}</dd></div></dl></div></div></section>
{if count($images)}<section class="project-gallery"><div class="container project-gallery__grid">{foreach $images as $index => $image}<a class="project-gallery__item project-gallery__item--{$index + 1}" href="{$image['image_path']}" data-lightbox><img src="{$image['image_path']}" width="1000" height="760" alt="{$image['alt_text'] ?: $project['title']}" loading="lazy"><span><i class="fa-solid fa-expand"></i></span></a>{/foreach}</div></section>{/if}
<section class="project-cta"><div class="container"><div><p class="eyebrow eyebrow--light">TIARA s.r.o.</p><h2>{if $lang === 'en'}Let’s build<br><em>something lasting.</em>{else}Pojďme vytvořit<br><em>něco, co vydrží.</em>{/if}</h2></div><a class="button button--gold" href="{if $lang === 'en'}/en/contact{else}/cs/kontakt{/if}">{$labels['quote']} <i class="fa-solid fa-arrow-right"></i></a></div></section>
{/block}
