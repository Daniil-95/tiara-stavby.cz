{block content}
<section class="detail-hero detail-hero--project">{var $projectHero = 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2200&q=84'}<img src="{$imageManager->safeUrl($project['main_image'], $projectHero)}" srcset="{$imageManager->srcSet($project['main_image'], $projectHero)}" sizes="100vw" width="2000" height="1180" alt="{$project['title']} — {$project['location']}" fetchpriority="high"><div class="detail-hero__overlay"></div><div class="container detail-hero__content"><a class="back-link" href="/realizace"><i class="fa-solid fa-arrow-left"></i> {$labels['back']}</a><p class="eyebrow eyebrow--light">{$project['category']} · {$project['year']}</p><h1>{$project['title']}</h1><p>{$project['location']}</p></div></section>
<section class="project-story section-space"><div class="container project-story__grid"><div><p class="eyebrow">O REALIZACI</p><h2>Na detailech<br><em>záleží.</em></h2></div><div><p class="lead">{$project['short_description']}</p><p>{$project['description']}</p><dl class="project-facts"><div><dt>{$labels['category']}</dt><dd>{$project['category']}</dd></div><div><dt>{$labels['location']}</dt><dd>{$project['location']}</dd></div><div><dt>{$labels['year']}</dt><dd>{$project['year']}</dd></div></dl></div></div></section>
<section class="project-cta"><div class="container"><div><p class="eyebrow eyebrow--light">TIARA s.r.o.</p><h2>Pojďme vytvořit<br><em>něco, co vydrží.</em></h2></div><a class="button button--gold" href="/#contact">{$labels['quote']} <i class="fa-solid fa-arrow-right"></i></a></div></section>
{/block}
