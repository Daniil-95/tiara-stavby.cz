{block content}
<section class="page-hero page-hero--image"><img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=2200&q=84" width="2000" height="900" alt="Moderní architektura rodinného domu" fetchpriority="high"><div class="page-hero__overlay"></div><div class="container page-hero__inner page-hero__inner--image"><div><p class="eyebrow eyebrow--light">TIARA s.r.o. / {if $lang === 'en'}SERVICES{else}SLUŽBY{/if}</p><h1>{if $lang === 'en'}One partner.<br><em>Every detail.</em>{else}Jeden partner.<br><em>Každý detail.</em>{/if}</h1><p class="page-hero__lead">{if $lang === 'en'}From the first plan to the final finish, we make complex work feel straightforward.{else}Od prvního plánu po poslední detail. S námi jsou komplexní práce srozumitelné.{/if}</p></div></div></section>
<section class="service-list section-space"><div class="container">{foreach $services as $index => $service}<article class="service-row" data-reveal><div class="service-row__count">0{$index + 1}</div><a class="service-row__image" href="{if $lang === 'en'}/en/services/{$service['slug']}{else}/cs/sluzby/{$service['slug']}{/if}"><img src="{$service['image_path'] ?: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1100&q=80'}" width="900" height="650" alt="{$service['title']}" loading="lazy"></a><div class="service-row__text"><i class="{$service['icon']}"></i><h2>{$service['title']}</h2><p>{$service['short_description']}</p><a class="text-link" href="{if $lang === 'en'}/en/services/{$service['slug']}{else}/cs/sluzby/{$service['slug']}{/if}">{$labels['more']} <i class="fa-solid fa-arrow-right"></i></a></div></article>{/foreach}</div></section>
<section class="service-steps"><div class="container"><p class="eyebrow eyebrow--light">{if $lang === 'en'}A CLEAR PROCESS{else}JASNÝ POSTUP{/if}</p><h2>{if $lang === 'en'}Good work begins<br><em>with a good plan.</em>{else}Dobrá práce začíná<br><em>dobrým plánem.</em>{/if}</h2><div class="service-steps__grid"><div><span>01</span><h3>{if $lang === 'en'}Consultation{else}Konzultace{/if}</h3><p>{if $lang === 'en'}We learn what matters to you.{else}Poznáme vaše potřeby a priority.{/if}</p></div><div><span>02</span><h3>{if $lang === 'en'}Proposal & plan{else}Návrh a plán{/if}</h3><p>{if $lang === 'en'}We agree on scope, timing and budget.{else}Dohodneme rozsah, termín i rozpočet.{/if}</p></div><div><span>03</span><h3>{if $lang === 'en'}Realisation{else}Realizace{/if}</h3><p>{if $lang === 'en'}We coordinate work and keep you informed.{else}Koordinujeme práci a informujeme vás.{/if}</p></div><div><span>04</span><h3>{if $lang === 'en'}Handover{else}Předání{/if}</h3><p>{if $lang === 'en'}We check the details and hand over with care.{else}Zkontrolujeme detaily a vše vám předáme.{/if}</p></div></div></div></section>
<section class="cta-strip"><div class="container"><p>{if $lang === 'en'}Let’s find the right solution for you.{else}Najdeme řešení, které vám bude vyhovovat.{/if}</p><a href="{if $lang === 'en'}/en/contact{else}/cs/kontakt{/if}">{$labels['quote']} <i class="fa-solid fa-arrow-right"></i></a></div></section>
{/block}
