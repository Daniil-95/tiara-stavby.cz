{block content}
<section class="detail-hero"><img src="{$service['image_path'] ?: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2200&q=84'}" width="2000" height="1050" alt="{$service['title']} — TIARA s.r.o." fetchpriority="high"><div class="detail-hero__overlay"></div><div class="container detail-hero__content"><p class="eyebrow eyebrow--light">TIARA s.r.o. / {if $lang === 'en'}SERVICES{else}SLUŽBY{/if}</p><h1>{$service['title']}</h1><p>{$service['short_description']}</p><a class="button button--gold" href="{if $lang === 'en'}/en/contact{else}/cs/kontakt{/if}">{$labels['quote']} <i class="fa-solid fa-arrow-right"></i></a></div></section>
<section class="detail-content section-space"><div class="container detail-content__grid"><aside><span class="eyebrow">{$service['icon']}</span><span class="detail-content__aside">TIARA<br>{if $lang === 'en'}BUILDING{else}STAVBY{/if}</span></aside><div><h2>{if $lang === 'en'}Thoughtful work,<br><em>lasting value.</em>{else}Promyšlená práce,<br><em>hodnota na dlouhá léta.</em>{/if}</h2><p class="lead">{$service['content']}</p><div class="detail-benefits"><div><i class="fa-solid fa-check"></i><span>{if $lang === 'en'}One accountable partner{else}Jeden partner za výsledek{/if}</span></div><div><i class="fa-solid fa-check"></i><span>{if $lang === 'en'}Clear schedule and communication{else}Jasný harmonogram a komunikace{/if}</span></div><div><i class="fa-solid fa-check"></i><span>{if $lang === 'en'}Quality work from start to finish{else}Kvalita od začátku do konce{/if}</span></div></div></div></div></section>
<section class="faq-section"><div class="container faq-section__grid"><div><p class="eyebrow">{if $lang === 'en'}COMMON QUESTIONS{else}ČASTÉ OTÁZKY{/if}</p><h2>{if $lang === 'en'}A few useful<br><em>answers.</em>{else}Pár užitečných<br><em>odpovědí.</em>{/if}</h2></div><div><details><summary>{if $lang === 'en'}Can you manage the whole project?{else}Zajistíte celý projekt?{/if}<i class="fa-solid fa-plus"></i></summary><p>{if $lang === 'en'}Yes. We can coordinate the full process from consultation and planning through the finishing work.{else}Ano, koordinujeme celý proces od konzultace a plánování až po dokončovací práce.{/if}</p></details><details><summary>{if $lang === 'en'}How do you prepare a quote?{else}Jak připravíte cenovou nabídku?{/if}<i class="fa-solid fa-plus"></i></summary><p>{if $lang === 'en'}We first understand the brief and review the property, then prepare a clear proposal with scope and timing.{else}Nejdříve projdeme zadání a stav nemovitosti. Poté připravíme přehledný návrh rozsahu a termínů.{/if}</p></details><details><summary>{if $lang === 'en'}Can work be phased?{else}Lze práce rozdělit do etap?{/if}<i class="fa-solid fa-plus"></i></summary><p>{if $lang === 'en'}We plan phases with you and take the practical needs of your household or business into account.{else}Etapy plánujeme společně s vámi a zohledňujeme praktické fungování domácnosti nebo firmy.{/if}</p></details></div></div></section>
<section class="cta-strip"><div class="container"><p>{$labels['step']}</p><a href="{if $lang === 'en'}/en/contact{else}/cs/kontakt{/if}">{$labels['contactUs']} <i class="fa-solid fa-arrow-right"></i></a></div></section>
{/block}
