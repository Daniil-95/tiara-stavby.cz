{block content}
<section class="detail-hero">{var $serviceHero = 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=84'}<img src="{$imageManager->safeUrl($service['image_path'], $serviceHero)}" srcset="{$imageManager->srcSet($service['image_path'], $serviceHero)}" sizes="100vw" width="2000" height="1050" alt="{$service['title']} — TIARA s.r.o." fetchpriority="high"><div class="detail-hero__overlay"></div><div class="container detail-hero__content"><p class="eyebrow eyebrow--light">TIARA s.r.o. / SLUŽBY</p><h1>{$service['title']}</h1><p>{$service['short_description']}</p><a class="button button--gold" href="/#contact">{$labels['quote']} <i class="fa-solid fa-arrow-right"></i></a></div></section>
<section class="detail-content section-space"><div class="container detail-content__grid detail-content__grid--single"><div><h2>Promyšlená práce,<br><em>hodnota na dlouhá léta.</em></h2><p class="lead">{$service['content']}</p><div class="detail-benefits"><div><i class="fa-solid fa-check"></i><span>Jeden partner za výsledek</span></div><div><i class="fa-solid fa-check"></i><span>Jasný harmonogram a komunikace</span></div><div><i class="fa-solid fa-check"></i><span>Kvalita od začátku do konce</span></div></div></div></div></section>
<section class="faq-section"><div class="container faq-section__grid"><div><p class="eyebrow">ČASTÉ OTÁZKY</p><h2>Pár užitečných<br><em>odpovědí.</em></h2></div><div>{foreach $faqs as $faq}<details><summary>{$faq['question']}<i class="fa-solid fa-plus"></i></summary><p>{$faq['answer']}</p></details>{/foreach}</div></div></section>
<section class="cta-strip"><div class="container"><p>{$labels['step']}</p><a href="/#contact">{$labels['contactUs']} <i class="fa-solid fa-arrow-right"></i></a></div></section>
{/block}
