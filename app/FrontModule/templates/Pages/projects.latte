{block content}
<section class="page-hero page-hero--light"><div class="container page-hero__inner"><div><p class="eyebrow">TIARA s.r.o. / VYBRANÉ REALIZACE</p><h1>S péčí vytvořeno.<br><em>Na dlouhá léta.</em></h1><p class="page-hero__lead">Výběr našich realizací v oblasti rodinných domů, rekonstrukcí a komerčních prostor.</p></div><div class="page-hero__number">{count($projects)}<span>—</span>PROJEKTŮ</div></div></section>
<section class="all-projects section-space"><div class="container"><div class="project-filters"><a href="/realizace" class="{if !$selectedCategory}is-active{/if}">Všechny realizace</a>{foreach $categories as $category}<a href="/realizace?category={$category|escapeUrl}" class="{if $selectedCategory === $category}is-active{/if}">{$category}</a>{/foreach}</div><div class="project-grid project-grid--all">{foreach $projects as $index => $project}{var $projectImage = 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1400&q=80'}<article class="project-card" data-reveal style="--delay: {$index % 3 * 80}ms"><a class="project-card__visual" href="/realizace/{$project['id']}"><img src="{$imageManager->safeUrl($project['main_image'], $projectImage)}" srcset="{$imageManager->srcSet($project['main_image'], $projectImage)}" sizes="(max-width: 600px) 100vw, 50vw" width="1000" height="760" alt="{$project['title']} — {$project['location']}" loading="lazy"><span class="project-card__open"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a><div class="project-card__meta"><span>{$project['category']}</span><span>{$project['year']}</span></div><h2><a href="/realizace/{$project['id']}">{$project['title']}</a></h2><p>{$project['location']}</p><p class="project-card__description">{$project['short_description']}</p></article>{/foreach}</div></div></section>
<section class="cta-strip"><div class="container"><p>Další realizace může být právě ta vaše.</p><a href="/#contact">{$labels['quote']} <i class="fa-solid fa-arrow-right"></i></a></div></section>
{/block}
