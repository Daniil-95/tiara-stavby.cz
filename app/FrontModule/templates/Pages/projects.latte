{block content}
<section class="page-hero page-hero--light"><div class="container page-hero__inner"><div><p class="eyebrow">TIARA s.r.o. / VYBRANÉ REALIZACE</p><h1>Naše práce.<br><em>V obrazech.</em></h1><p class="page-hero__lead">Prohlédněte si výběr realizací TIARA.</p></div></div></section>
<section class="all-projects section-space"><div class="container"><div class="project-grid project-grid--all project-grid--gallery">{foreach $projects as $index => $project}{var $projectImage = 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1400&q=80'}{foreach $project['gallery'] as $image}<article class="project-card" data-reveal style="--delay: {$index % 3 * 80}ms"><a class="project-card__visual" href="{$imageManager->safeUrl($image['image_path'] ?? $project['main_image'], $projectImage)}" data-fancybox="projects" data-caption="{$project['title']} — {$project['short_description']}" aria-label="{$project['title']} — otevřít fotografii"><img src="{$imageManager->safeUrl($image['image_path'] ?? $project['main_image'], $projectImage)}" srcset="{$imageManager->srcSet($image['image_path'] ?? $project['main_image'], $projectImage)}" sizes="(max-width: 600px) 100vw, 50vw" width="1000" height="760" alt="{$image['alt_text'] ?? $project['title']}" loading="lazy"><span class="project-card__open"><i class="fa-solid fa-magnifying-glass-plus"></i></span></a></article>{/foreach}{/foreach}</div></div></section>
{/block}
