{block content}
<section class="page-hero page-hero--light"><div class="container page-hero__inner"><div><p class="eyebrow">TIARA s.r.o. / {if $lang === 'en'}SELECTED PROJECTS{else}VYBRANÉ REALIZACE{/if}</p><h1>{if $lang === 'en'}Made with care.<br><em>Built to last.</em>{else}S péčí vytvořeno.<br><em>Na dlouhá léta.</em>{/if}</h1><p class="page-hero__lead">{if $lang === 'en'}A selection of our recent work in homes, renovations and commercial spaces.{else}Výběr našich realizací v oblasti rodinných domů, rekonstrukcí a komerčních prostor.{/if}</p></div><div class="page-hero__number">{count($projects)}<span>—</span>{if $lang === 'en'}PROJECTS{else}PROJEKTŮ{/if}</div></div></section>
<section class="all-projects section-space"><div class="container"><div class="project-grid project-grid--all">{foreach $projects as $index => $project}<article class="project-card" data-reveal style="--delay: {$index % 3 * 80}ms"><a class="project-card__visual" href="{if $lang === 'en'}/en/projects/{$project['id']}{else}/cs/realizace/{$project['id']}{/if}"><img src="{$project['main_image'] ?: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1400&q=80'}" width="1000" height="760" alt="{$project['title']} — {$project['location']}" loading="lazy"><span class="project-card__open"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a><div class="project-card__meta"><span>{$project['category']}</span><span>{$project['year']}</span></div><h2><a href="{if $lang === 'en'}/en/projects/{$project['id']}{else}/cs/realizace/{$project['id']}{/if}">{$project['title']}</a></h2><p>{$project['location']}</p><p class="project-card__description">{$project['short_description']}</p></article>{/foreach}</div></div></section>
<section class="cta-strip"><div class="container"><p>{if $lang === 'en'}Your project could be next.{else}Další realizace může být právě ta vaše.{/if}</p><a href="{if $lang === 'en'}/en/contact{else}/cs/kontakt{/if}">{$labels['quote']} <i class="fa-solid fa-arrow-right"></i></a></div></section>
{/block}
