{block content}
<section class="page-hero page-hero--light"><div class="container page-hero__inner"><div><p class="eyebrow">TIARA s.r.o. / {if $lang === 'en'}ABOUT US{else}O NÁS{/if}</p><h1>{if $lang === 'en'}Built on trust.<br><em>Made to last.</em>{else}Stavíme na důvěře.<br><em>S výhledem do budoucna.</em>{/if}</h1><p class="page-hero__lead">{ifset $section}{$section['subtitle']}{else}TIARA s.r.o.{/ifset}</p></div><div class="page-hero__number">01<span>—</span>06</div></div></section>
<section class="about-story section-space"><div class="container about-story__grid"><div class="about-story__media"><img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1500&q=84" width="1150" height="900" alt="Průběh stavby a práce stavebního týmu" loading="lazy"><span>{if $lang === 'en'}Built with care.{else}S péčí o každý detail.{/if}</span></div><div><p class="eyebrow">{if $lang === 'en'}A PARTNER FROM FIRST SKETCH TO HANDOVER{else}PARTNER OD PRVNÍ KONZULTACE AŽ PO PŘEDÁNÍ{/if}</p><h2>{ifset $section}{$section['title']}{else}{if $lang === 'en'}Your dependable construction partner{else}Spolehlivý stavební partner{/if}{/ifset}</h2><p class="lead">{ifset $section}{$section['content']}{else}{if $lang === 'en'}We bring people, craft and clear planning together to make buildings that work beautifully for the people who use them.{else}Propojujeme lidi, poctivé řemeslo a promyšlené plánování. Vznikají tak stavby, které dobře slouží těm, kdo je každý den používají.{/if}{/ifset}</p><p>{if $lang === 'en'}Our work covers new family homes, apartment renovations, modernisations and commercial interiors. We make decisions together with our clients, share progress openly and take responsibility for the finished result.{else}Věnujeme se novostavbám rodinných domů, rekonstrukcím bytů, modernizacím i komerčním interiérům. Rozhodnutí děláme společně s klienty, otevřeně informujeme o postupu a ručíme za dokončené dílo.{/if}</p><a class="button button--navy" href="{if $lang === 'en'}/en/contact{else}/cs/kontakt{/if}">{$labels['quote']}<i class="fa-solid fa-arrow-right"></i></a></div></div></section>
<section class="principles section-space"><div class="container"><p class="eyebrow">{if $lang === 'en'}HOW WE WORK{else}JAK PRACUJEME{/if}</p><div class="principles__grid"><article><span>01</span><h3>{if $lang === 'en'}We listen first.{else}Nejdříve nasloucháme.{/if}</h3><p>{if $lang === 'en'}Your brief and priorities guide each decision.{else}Vaše představy a priority vedou každé naše rozhodnutí.{/if}</p></article><article><span>02</span><h3>{if $lang === 'en'}We plan together.{else}Plánujeme společně.{/if}</h3><p>{if $lang === 'en'}Clear steps, costs and responsibilities before work begins.{else}Před zahájením si vyjasníme kroky, cenu i odpovědnosti.{/if}</p></article><article><span>03</span><h3>{if $lang === 'en'}We stand by the result.{else}Stojíme si za výsledkem.{/if}</h3><p>{if $lang === 'en'}Quality checks and honest communication all the way through.{else}Kontrolujeme kvalitu a jednáme otevřeně po celou dobu.{/if}</p></article></div></div></section>
<section class="cta-strip"><div class="container"><p>{if $lang === 'en'}Have a project on your mind?{else}Máte projekt v plánu?{/if}</p><a href="{if $lang === 'en'}/en/contact{else}/cs/kontakt{/if}">{$labels['contactUs']} <i class="fa-solid fa-arrow-right"></i></a></div></section>
{/block}
