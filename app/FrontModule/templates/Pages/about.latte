{block content}
{var $aboutImageFallback = 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1500&q=84'}{var $aboutImage = $imageManager->safeUrl($section['image_path'] ?? null, $aboutImageFallback)}
<section class="page-hero page-hero--light"><div class="container page-hero__inner"><div><p class="eyebrow">TIARA s.r.o. / O NÁS</p><h1>Stavíme na důvěře.<br><em>S výhledem do budoucna.</em></h1><p class="page-hero__lead">{ifset $section}{$section['subtitle']}{else}TIARA s.r.o.{/ifset}</p></div><div class="page-hero__number">01<span>—</span>06</div></div></section>
<section class="about-story section-space"><div class="container about-story__grid"><div class="about-story__media"><img src="{$aboutImage}" srcset="{$imageManager->srcSet($section['image_path'] ?? null, $aboutImageFallback)}" sizes="(max-width: 600px) 93vw, 45vw" width="1150" height="900" alt="{$company['about_image_alt'] ?? 'Průběh stavby a práce stavebního týmu'}" loading="lazy"><span>S péčí o každý detail.</span></div><div><p class="eyebrow">PARTNER OD PRVNÍ KONZULTACE AŽ PO PŘEDÁNÍ</p><h2>{ifset $section}{$section['title']}{else}Spolehlivý stavební partner{/ifset}</h2><p class="lead">{ifset $section}{$section['content']}{else}Propojujeme lidi, poctivé řemeslo a promyšlené plánování. Vznikají tak stavby, které dobře slouží těm, kdo je každý den používají.{/ifset}</p><p>Věnujeme se novostavbám rodinných domů, rekonstrukcím bytů, modernizacím i komerčním interiérům. Rozhodnutí děláme společně s klienty, otevřeně informujeme o postupu a ručíme za dokončené dílo.</p><a class="button button--navy" href="/kontakt">{$labels['quote']}<i class="fa-solid fa-arrow-right"></i></a></div></div></section>
<section class="principles section-space"><div class="container"><p class="eyebrow">JAK PRACUJEME</p><div class="principles__grid"><article><span>01</span><h3>Nejdříve nasloucháme.</h3><p>Vaše představy a priority vedou každé naše rozhodnutí.</p></article><article><span>02</span><h3>Plánujeme společně.</h3><p>Před zahájením si vyjasníme kroky, cenu i odpovědnosti.</p></article><article><span>03</span><h3>Stojíme si za výsledkem.</h3><p>Kontrolujeme kvalitu a jednáme otevřeně po celou dobu.</p></article></div></div></section>
<section class="cta-strip"><div class="container"><p>Máte projekt v plánu?</p><a href="/kontakt">{$labels['contactUs']} <i class="fa-solid fa-arrow-right"></i></a></div></section>
{/block}
