{block content}
{var $heroFallback = 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=85'}{var $heroImage = $imageManager->safeUrl($company['home_hero_image'] ?? null, $heroFallback)}
<section class="hero" aria-labelledby="hero-title" data-editor-section="home-hero">
	<picture class="hero__picture"><img src="{$heroImage}" srcset="{$imageManager->srcSet($company['home_hero_image'] ?? null, $heroFallback)}" sizes="100vw" width="2000" height="1268" alt="{$company['home_hero_image_alt'] ?? 'Moderní rodinný dům obklopený zelení'}" fetchpriority="high"></picture>
	<div class="hero__scrim"></div>
	<div class="container hero__content"><div class="hero__copy" data-reveal><p class="eyebrow eyebrow--light"><span></span>{$company['home_hero_kicker'] ?? 'STAVÍME VAŠI LEPŠÍ BUDOUCNOST'}</p><h1 id="hero-title">{$company['home_hero_line_one'] ?? 'VEŠKERÉ'}<br><em>{$company['home_hero_line_two'] ?? 'STAVEBNÍ PRÁCE'}</em></h1><p class="hero__lead">{ifset $intro}{$intro['content']}{else}Kvalitní výstavba, rekonstrukce a modernizace pro váš domov i podnikání.{/ifset}</p><div class="hero__actions"><a class="button button--gold" href="/sluzby">Naše služby<i class="fa-solid fa-arrow-right"></i></a><a class="button button--outline-light" href="/kontakt">{$labels['quote']}</a></div></div>
		<div class="hero__side" aria-hidden="true"><span>TIARA <i>01</i></span><span class="hero__line"></span><span>VÝSTAVBA · REKONSTRUKCE · MODERNIZACE</span></div>
	</div><a class="hero__scroll" href="#services"><span></span>Prozkoumat</a>
</section>

<section class="services-section section-space" id="services">
	<div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow">01 / CO DĚLÁME</p><h2>Vaše představa.<br><em>Naše práce.</em></h2></div><p>Jeden zkušený partner pro každou etapu vašeho stavebního projektu.</p></div>
		<div class="service-grid">{foreach $services as $index => $service}{var $serviceImage = 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=78'}<article class="service-card" data-reveal style="--delay: {$index * 90}ms"><a class="service-card__image" href="/sluzby/{$service['slug']}"><img src="{$imageManager->safeUrl($service['image_path'], $serviceImage)}" srcset="{$imageManager->srcSet($service['image_path'], $serviceImage)}" sizes="(max-width: 600px) 100vw, (max-width: 820px) 33vw, 420px" width="760" height="600" alt="{$service['title']} — TIARA stavební práce" loading="lazy"><span class="service-card__number">0{$index + 1}</span><span class="service-card__icon"><i class="{$service['icon']}"></i></span></a><div class="service-card__body"><h3>{$service['title']}</h3><p>{$service['short_description']}</p><a class="text-link" href="/sluzby/{$service['slug']}">{$labels['more']} <i class="fa-solid fa-arrow-right"></i></a></div></article>{/foreach}</div>
	</div>
</section>

<section class="about-section section-space">
	{var $homeAboutFallback = 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=82'}{var $homeAboutImage = $imageManager->safeUrl($company['home_about_image'] ?? null, $homeAboutFallback)}
	<div class="container about-grid"><div class="about-media" data-reveal><img class="about-media__main" src="{$homeAboutImage}" srcset="{$imageManager->srcSet($company['home_about_image'] ?? null, $homeAboutFallback)}" sizes="(max-width: 600px) 90vw, 45vw" width="920" height="1120" alt="{$company['home_about_image_alt'] ?? 'Stavební tým TIARA při práci na realizaci'}" loading="lazy"><div class="about-stamp"><span>TIARA</span><small>OD ROKU<br>2014</small></div><div class="about-media__caption">Záleží na každém detailu.</div></div>
		<div class="about-copy" data-reveal><p class="eyebrow">02 / O SPOLEČNOSTI</p><h2>SPOLEHLIVÝ<br><em>STAVEBNÍ PARTNER</em></h2><p class="lead">{ifset $about}{$about['content']}{else}Stojíme si za svým slovem, ručíme za každý detail a provázíme váš projekt od první konzultace až po předání hotového díla.{/ifset}</p><div class="about-points"><p><i class="fa-solid fa-check"></i>Soukromé i komerční projekty</p><p><i class="fa-solid fa-check"></i>Jeden partner a srozumitelná komunikace</p><p><i class="fa-solid fa-check"></i>Moderní postupy. Poctivé řemeslo.</p></div><a class="button button--navy" href="/o-nas">Více o nás<i class="fa-solid fa-arrow-right"></i></a></div>
	</div>
</section>

<section class="benefits section-space">
	<div class="container"><div class="section-heading section-heading--light" data-reveal><div><p class="eyebrow eyebrow--light">03 / PROČ TIARA</p><h2>Jistota v každém<br><em>detailu.</em></h2></div><p>Dobrá stavba začíná nasloucháním a končí výsledkem, který obstojí v čase.</p></div>
		<div class="benefit-list"><article data-reveal><span>01</span><i class="fa-solid fa-ruler-combined"></i><h3>Kvalita a preciznost</h3><p>Pečlivé řemeslné provedení v každé vrstvě.</p></article><article data-reveal><span>02</span><i class="fa-regular fa-clock"></i><h3>Spolehlivé termíny</h3><p>Jasný plán a dohody, které platí.</p></article><article data-reveal><span>03</span><i class="fa-solid fa-handshake"></i><h3>Osobní přístup</h3><p>Řešení připravené podle vašich potřeb.</p></article><article data-reveal><span>04</span><i class="fa-solid fa-compass-drafting"></i><h3>Moderní technologie</h3><p>Promyšlené materiály a ověřené postupy.</p></article></div>
	</div>
</section>

<section class="projects-section section-space">
	<div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow">04 / VYBRANÉ REALIZACE</p><h2>Výsledky, které<br><em>mluví samy.</em></h2></div><a class="text-link" href="/realizace">{$labels['allProjects']} <i class="fa-solid fa-arrow-right"></i></a></div>
		<div class="project-grid">{foreach $projects as $index => $project}{var $projectImage = 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1400&q=80'}<article class="project-card project-card--{$index + 1}" data-reveal style="--delay: {$index * 110}ms"><a class="project-card__visual" href="/realizace/{$project['id']}"><img src="{$imageManager->safeUrl($project['main_image'], $projectImage)}" srcset="{$imageManager->srcSet($project['main_image'], $projectImage)}" sizes="(max-width: 600px) 100vw, (max-width: 820px) 56vw, 760px" width="1000" height="760" alt="{$project['title']} — {$project['location']}" loading="lazy"><span class="project-card__open"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a><div class="project-card__meta"><span>{$project['category']}</span><span>{$project['year']}</span></div><h3><a href="/realizace/{$project['id']}">{$project['title']}</a></h3><p>{$project['location']}</p></article>{/foreach}</div>
	</div>
</section>

<section class="stats-band"><div class="container stats-band__inner"><div class="stats-band__intro"><p class="eyebrow eyebrow--light">TIARA s.r.o.</p><h2>Zkušenost,<br>která se počítá.</h2></div><div class="stats-list">{var $statValues = explode('|', $stats['content'] ?? '100+ realizovaných projektů|10+ let zkušeností|100% spokojených zákazníků|Stavíme s jistotou.')}<div><strong>{$company['stat_projects'] ?? '100+'}</strong><span>realizovaných projektů</span></div><div><strong>{$company['stat_years'] ?? '10+'}</strong><span>let zkušeností</span></div><div><strong>{$company['stat_satisfaction'] ?? '100%'}</strong><span>spokojených zákazníků</span></div><div><strong>→</strong><span>{$statValues[3] ?? ($company['tagline'] ?? 'Stavíme s jistotou.')}</span></div></div></div></section>

<section class="cta-section"><div class="container cta-section__inner" data-reveal><div><p class="eyebrow eyebrow--light">{$company['home_cta_kicker'] ?? 'VÁŠ DALŠÍ PROJEKT'}</p><h2>{$company['home_cta_line_one'] ?? 'PLÁNUJETE STAVBU'}<br><span class="cta-mobile-space"> </span>{$company['home_cta_line_two'] ?? 'NEBO REKONSTRUKCI?'}</h2><p class="cta-section__copy">{$cta['content'] ?? 'Ozvěte se nám a probereme váš projekt.'}</p></div><a class="button button--gold" href="{$company['home_cta_url'] ?? '/kontakt'}">{$company['home_cta_button'] ?? $labels['quote']}<i class="fa-solid fa-arrow-right"></i></a></div><div class="cta-section__shape"></div></section>

<section class="contact-section section-space" id="contact"><div class="container contact-grid"><div class="contact-copy" data-reveal><p class="eyebrow">05 / SPOJME SE</p><h2>Dobrý projekt<br>začíná <em>rozhovorem.</em></h2><p>Řekněte nám, co plánujete. Ozveme se vám a společně najdeme další krok.</p><div class="contact-details"><a href="tel:{$company['phone'] ?? '+420000000000'}"><span class="contact-details__icon"><i class="fa-solid fa-phone"></i></span><span><small>{$labels['phone']}</small><strong>{$company['phone'] ?? '+420 000 000 000'}</strong></span></a><a href="mailto:{$company['email'] ?? 'info@tiara-stavby.cz'}"><span class="contact-details__icon"><i class="fa-regular fa-envelope"></i></span><span><small>{$labels['email']}</small><strong>{$company['email'] ?? 'info@tiara-stavby.cz'}</strong></span></a><div><span class="contact-details__icon"><i class="fa-solid fa-location-dot"></i></span><span><small>{$labels['address']}</small><strong>{$company['address'] ?? 'Česká republika'}</strong></span></div></div></div><div class="contact-form-wrap" data-reveal><div class="contact-form-wrap__top"><span>Napište nám o svém projektu</span><i class="fa-solid fa-arrow-down-long"></i></div>{control inquiryForm}</div></div></section>
{/block}
