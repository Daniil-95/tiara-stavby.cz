{block content}
<section class="hero" aria-labelledby="hero-title">
	<picture class="hero__picture"><source media="(max-width: 680px)" srcset="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=920&q=78"><img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=85" width="2000" height="1268" alt="Moderní rodinný dům obklopený zelení" fetchpriority="high"></picture>
	<div class="hero__scrim"></div>
	<div class="container hero__content"><div class="hero__copy" data-reveal><p class="eyebrow eyebrow--light"><span></span>{if $lang === 'en'}BUILDING A BETTER FUTURE{else}STAVÍME VAŠI LEPŠÍ BUDOUCNOST{/if}</p><h1 id="hero-title">{if $lang === 'en'}CONSTRUCTION<br><em>WITH PURPOSE</em>{else}VEŠKERÉ<br><em>STAVEBNÍ PRÁCE</em>{/if}</h1><p class="hero__lead">{ifset $intro}{$intro['content']}{else}{if $lang === 'en'}Quality construction, renovation and modernisation for your home and business.{else}Kvalitní výstavba, rekonstrukce a modernizace pro váš domov i podnikání.{/if}{/ifset}</p><div class="hero__actions"><a class="button button--gold" href="{if $lang === 'en'}/en/services{else}/cs/sluzby{/if}">{if $lang === 'en'}Our services{else}Naše služby{/if}<i class="fa-solid fa-arrow-right"></i></a><a class="button button--outline-light" href="{if $lang === 'en'}/en/contact{else}/cs/kontakt{/if}">{$labels['quote']}</a></div></div>
		<div class="hero__side" aria-hidden="true"><span>TIARA <i>01</i></span><span class="hero__line"></span><span>{if $lang === 'en'}CONSTRUCTION · RENOVATION · MODERNISATION{else}VÝSTAVBA · REKONSTRUKCE · MODERNIZACE{/if}</span></div>
	</div><a class="hero__scroll" href="#services"><span></span>{if $lang === 'en'}Explore{else}Prozkoumat{/if}</a>
</section>

<section class="services-section section-space" id="services">
	<div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow">01 / {if $lang === 'en'}WHAT WE DO{else}CO DĚLÁME{/if}</p><h2>{if $lang === 'en'}Built around <em>your vision.</em>{else}Vaše představa.<br><em>Naše práce.</em>{/if}</h2></div><p>{if $lang === 'en'}A single, experienced partner for every stage of your property project.{else}Jeden zkušený partner pro každou etapu vašeho stavebního projektu.{/if}</p></div>
		<div class="service-grid">{foreach $services as $index => $service}<article class="service-card" data-reveal style="--delay: {$index * 90}ms"><a class="service-card__image" href="{if $lang === 'en'}/en/services/{$service['slug']}{else}/cs/sluzby/{$service['slug']}{/if}"><img src="{$service['image_path'] ?: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1100&q=78'}" width="760" height="600" alt="{$service['title']} — TIARA stavební práce" loading="lazy"><span class="service-card__number">0{$index + 1}</span><span class="service-card__icon"><i class="{$service['icon']}"></i></span></a><div class="service-card__body"><h3>{$service['title']}</h3><p>{$service['short_description']}</p><a class="text-link" href="{if $lang === 'en'}/en/services/{$service['slug']}{else}/cs/sluzby/{$service['slug']}{/if}">{$labels['more']} <i class="fa-solid fa-arrow-right"></i></a></div></article>{/foreach}</div>
	</div>
</section>

<section class="about-section section-space">
	<div class="container about-grid"><div class="about-media" data-reveal><img class="about-media__main" src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=82" width="920" height="1120" alt="Stavební tým TIARA při práci na realizaci" loading="lazy"><div class="about-stamp"><span>TIARA</span><small>OD ROKU<br>2014</small></div><div class="about-media__caption">{if $lang === 'en'}Attention to every detail.{else}Záleží na každém detailu.{/if}</div></div>
		<div class="about-copy" data-reveal><p class="eyebrow">02 / {if $lang === 'en'}ABOUT TIARA{else}O SPOLEČNOSTI{/if}</p><h2>{if $lang === 'en'}A dependable<br><em>construction partner.</em>{else}SPOLEHLIVÝ<br><em>STAVEBNÍ PARTNER</em>{/if}</h2><p class="lead">{ifset $about}{$about['content']}{else}{if $lang === 'en'}We stand by our word, take responsibility for every detail and guide your project from the first conversation to the final handover.{else}Stojíme si za svým slovem, ručíme za každý detail a provázíme váš projekt od první konzultace až po předání hotového díla.{/if}{/ifset}</p><div class="about-points"><p><i class="fa-solid fa-check"></i>{if $lang === 'en'}Private homes and commercial projects{else}Soukromé i komerční projekty{/if}</p><p><i class="fa-solid fa-check"></i>{if $lang === 'en'}One point of contact, clear communication{else}Jeden partner a srozumitelná komunikace{/if}</p><p><i class="fa-solid fa-check"></i>{if $lang === 'en'}Modern methods. Proven craftsmanship.{else}Moderní postupy. Poctivé řemeslo.{/if}</p></div><a class="button button--navy" href="{if $lang === 'en'}/en/about{else}/cs/o-nas{/if}">{if $lang === 'en'}More about us{else}Více o nás{/if}<i class="fa-solid fa-arrow-right"></i></a></div>
	</div>
</section>

<section class="benefits section-space">
	<div class="container"><div class="section-heading section-heading--light" data-reveal><div><p class="eyebrow eyebrow--light">03 / {if $lang === 'en'}WHY TIARA{else}PROČ TIARA{/if}</p><h2>{if $lang === 'en'}Confidence built<br><em>into every detail.</em>{else}Jistota v každém<br><em>detailu.</em>{/if}</h2></div><p>{if $lang === 'en'}Good construction starts with listening and ends with a result that stands the test of time.{else}Dobrá stavba začíná nasloucháním a končí výsledkem, který obstojí v čase.{/if}</p></div>
		<div class="benefit-list"><article data-reveal><span>01</span><i class="fa-solid fa-ruler-combined"></i><h3>{if $lang === 'en'}Quality & precision{else}Kvalita a preciznost{/if}</h3><p>{if $lang === 'en'}Careful workmanship in every layer.{else}Pečlivé řemeslné provedení v každé vrstvě.{/if}</p></article><article data-reveal><span>02</span><i class="fa-regular fa-clock"></i><h3>{if $lang === 'en'}Reliable timing{else}Spolehlivé termíny{/if}</h3><p>{if $lang === 'en'}A clear plan and commitments we keep.{else}Jasný plán a dohody, které platí.{/if}</p></article><article data-reveal><span>03</span><i class="fa-solid fa-handshake"></i><h3>{if $lang === 'en'}Personal approach{else}Osobní přístup{/if}</h3><p>{if $lang === 'en'}A solution shaped around your needs.{else}Řešení připravené podle vašich potřeb.{/if}</p></article><article data-reveal><span>04</span><i class="fa-solid fa-compass-drafting"></i><h3>{if $lang === 'en'}Modern methods{else}Moderní technologie{/if}</h3><p>{if $lang === 'en'}Thoughtful materials and proven process.{else}Promyšlené materiály a ověřené postupy.{/if}</p></article></div>
	</div>
</section>

<section class="projects-section section-space">
	<div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow">04 / {if $lang === 'en'}SELECTED WORK{else}VYBRANÉ REALIZACE{/if}</p><h2>{if $lang === 'en'}Work that speaks<br><em>for itself.</em>{else}Výsledky, které<br><em>mluví samy.</em>{/if}</h2></div><a class="text-link" href="{if $lang === 'en'}/en/projects{else}/cs/realizace{/if}">{$labels['allProjects']} <i class="fa-solid fa-arrow-right"></i></a></div>
		<div class="project-grid">{foreach $projects as $index => $project}<article class="project-card project-card--{$index + 1}" data-reveal style="--delay: {$index * 110}ms"><a class="project-card__visual" href="{if $lang === 'en'}/en/projects/{$project['id']}{else}/cs/realizace/{$project['id']}{/if}"><img src="{$project['main_image'] ?: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1400&q=80'}" width="1000" height="760" alt="{$project['title']} — {$project['location']}" loading="lazy"><span class="project-card__open"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a><div class="project-card__meta"><span>{$project['category']}</span><span>{$project['year']}</span></div><h3><a href="{if $lang === 'en'}/en/projects/{$project['id']}{else}/cs/realizace/{$project['id']}{/if}">{$project['title']}</a></h3><p>{$project['location']}</p></article>{/foreach}</div>
	</div>
</section>

<section class="stats-band"><div class="container stats-band__inner"><div class="stats-band__intro"><p class="eyebrow eyebrow--light">TIARA s.r.o.</p><h2>{if $lang === 'en'}Experience you<br>can count on.{else}Zkušenost,<br>která se počítá.{/if}</h2></div><div class="stats-list">{var $statValues = explode('|', $stats['content'] ?? '100+ realizovaných projektů|10+ let zkušeností|100% osobní přístup|Stavíme s jistotou.')}<div><strong>{$company['stat_projects'] ?? '100+'}</strong><span>{if $lang === 'en'}completed projects{else}realizovaných projektů{/if}</span></div><div><strong>{$company['stat_years'] ?? '10+'}</strong><span>{if $lang === 'en'}years of experience{else}let zkušeností{/if}</span></div><div><strong>{$company['stat_satisfaction'] ?? '100%'}</strong><span>{if $lang === 'en'}personal approach{else}osobní přístup{/if}</span></div><div><strong>→</strong><span>{$company['tagline'] ?? 'Stavíme s jistotou.'}</span></div></div></div></section>

<section class="cta-section"><div class="container cta-section__inner" data-reveal><div><p class="eyebrow eyebrow--light">{if $lang === 'en'}YOUR NEXT CHAPTER{else}VÁŠ DALŠÍ PROJEKT{/if}</p><h2>{if $lang === 'en'}Planning a build<br>or renovation?{else}PLÁNUJETE STAVBU<br>NEBO REKONSTRUKCI?{/if}</h2></div><a class="button button--gold" href="{if $lang === 'en'}/en/contact{else}/cs/kontakt{/if}">{$labels['quote']}<i class="fa-solid fa-arrow-right"></i></a></div><div class="cta-section__shape"></div></section>

<section class="contact-section section-space" id="contact"><div class="container contact-grid"><div class="contact-copy" data-reveal><p class="eyebrow">05 / {if $lang === 'en'}LET’S CONNECT{else}SPOJME SE{/if}</p><h2>{if $lang === 'en'}A good project<br>starts with <em>a talk.</em>{else}Dobrý projekt<br>začíná <em>rozhovorem.</em>{/if}</h2><p>{if $lang === 'en'}Tell us what you are planning. We will get back to you with a clear next step.{else}Řekněte nám, co plánujete. Ozveme se vám a společně najdeme další krok.{/if}</p><div class="contact-details"><a href="tel:{$company['phone'] ?? '+420777123456'}"><span class="contact-details__icon"><i class="fa-solid fa-phone"></i></span><span><small>{$labels['phone']}</small><strong>{$company['phone'] ?? '+420 777 123 456'}</strong></span></a><a href="mailto:{$company['email'] ?? 'info@tiara-stavby.cz'}"><span class="contact-details__icon"><i class="fa-regular fa-envelope"></i></span><span><small>{$labels['email']}</small><strong>{$company['email'] ?? 'info@tiara-stavby.cz'}</strong></span></a><div><span class="contact-details__icon"><i class="fa-solid fa-location-dot"></i></span><span><small>{$labels['address']}</small><strong>{$company['address'] ?? 'Praha, Česká republika'}</strong></span></div></div></div><div class="contact-form-wrap" data-reveal><div class="contact-form-wrap__top"><span>{if $lang === 'en'}Tell us about your project{else}Napište nám o svém projektu{/if}</span><i class="fa-solid fa-arrow-down-long"></i></div>{control inquiryForm}</div></div></section>
{/block}
