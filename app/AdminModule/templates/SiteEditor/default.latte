{block content}
<div class="admin-page-heading site-editor-heading">
	<div><p class="admin-kicker">OBSAH WEBU / ÚPRAVA STRÁNKY</p><h1>{$editorPages[$editorPage]}</h1><p>Upravte texty a fotografie stránky na jednom místě.</p></div>
</div>
<div class="site-editor-layout">
	<div class="site-editor-main">
	{form pageForm}
		{if $editorPage === 'home'}
		<section class="editor-group"><header><span>01</span><div><h2>Úvodní obrazovka</h2><p>Texty a hlavní fotografie v horní části stránky.</p></div></header><div class="editor-fields editor-fields--two">
			<div class="editor-field editor-field--wide"><label>{label hero_kicker /}</label>{input hero_kicker}</div>
			<div class="editor-field"><label>{label hero_line_one /}</label>{input hero_line_one}</div><div class="editor-field"><label>{label hero_line_two /}</label>{input hero_line_two}</div>
			<div class="editor-field editor-field--wide"><label>{label hero_intro /}</label>{input hero_intro}</div>
			<div class="editor-field editor-field--wide"><label>{label hero_image /}</label>{input hero_image, data-preview-target => 'hero-preview'}<small>JPG, PNG, GIF nebo WebP, maximálně 8 MB.</small></div>
			<div class="editor-field editor-field--wide"><label>{label hero_image_alt /}</label>{input hero_image_alt}</div>
		</div></section>
		<section class="editor-group"><header><span>02</span><div><h2>Jistota v každém detailu</h2><p>Text a čtyři hlavní výhody společnosti.</p></div></header><div class="editor-fields editor-fields--two">
			<div class="editor-field editor-field--wide"><label>{label benefits_kicker /}</label>{input benefits_kicker}</div>
			<div class="editor-field"><label>{label benefits_title_one /}</label>{input benefits_title_one}</div><div class="editor-field"><label>{label benefits_title_two /}</label>{input benefits_title_two}</div>
			<div class="editor-field editor-field--wide"><label>{label benefits_intro /}</label>{input benefits_intro}</div>
			<div class="editor-field"><label>{label benefits_item_1_title /}</label>{input benefits_item_1_title}</div><div class="editor-field"><label>{label benefits_item_1_text /}</label>{input benefits_item_1_text}</div>
			<div class="editor-field"><label>{label benefits_item_2_title /}</label>{input benefits_item_2_title}</div><div class="editor-field"><label>{label benefits_item_2_text /}</label>{input benefits_item_2_text}</div>
			<div class="editor-field"><label>{label benefits_item_3_title /}</label>{input benefits_item_3_title}</div><div class="editor-field"><label>{label benefits_item_3_text /}</label>{input benefits_item_3_text}</div>
			<div class="editor-field"><label>{label benefits_item_4_title /}</label>{input benefits_item_4_title}</div><div class="editor-field"><label>{label benefits_item_4_text /}</label>{input benefits_item_4_text}</div>
		</div></section>
		<section class="editor-group"><header><span>03</span><div><h2>Čísla a zkušenosti</h2><p>Krátké hodnoty zobrazované v přehledu společnosti.</p></div></header><div class="editor-fields editor-fields--three">
			<div class="editor-field"><label>{label stat_projects /}</label>{input stat_projects}</div><div class="editor-field"><label>{label stat_years /}</label>{input stat_years}</div><div class="editor-field"><label>{label stat_satisfaction /}</label>{input stat_satisfaction}</div>
		</div></section>
		{elseif $editorPage === 'about'}
		<section class="editor-group"><header><span>01</span><div><h2>Texty stránky</h2><p>Hlavní nadpis, podnadpis a úvodní text.</p></div></header><div class="editor-fields">
			<div class="editor-field"><label>{label about_title /}</label>{input about_title}</div><div class="editor-field"><label>{label about_subtitle /}</label>{input about_subtitle}</div><div class="editor-field"><label>{label about_text /}</label>{input about_text}</div>
		</div></section>
		<section class="editor-group"><header><span>02</span><div><h2>Fotografie</h2><p>Fotografie stránky O nás a bloku na úvodní stránce.</p></div></header><div class="editor-fields editor-fields--two">
			<div class="editor-field"><label>{label about_image /}</label>{input about_image, data-preview-target => 'about-preview'}<small>JPG, PNG, GIF nebo WebP, maximálně 8 MB.</small></div><div class="editor-field"><label>{label about_image_alt /}</label>{input about_image_alt}</div>
			<div class="editor-field"><label>{label home_about_image /}</label>{input home_about_image, data-preview-target => 'home-about-preview'}<small>Fotografie bloku na úvodní stránce. JPG, PNG, GIF nebo WebP, maximálně 8 MB.</small></div><div class="editor-field"><label>{label home_about_image_alt /}</label>{input home_about_image_alt}</div>
		</div></section>
		{elseif $editorPage === 'seo'}
		<section class="editor-group"><header><span>01</span><div><h2>SEO pro vybranou stránku</h2><p>Vyberte stránku a upravte její název a popis pro vyhledávače.</p></div></header><div class="editor-fields editor-fields--two">
			<div class="editor-field editor-field--wide"><label>{label seo_path /}</label>{input seo_path}</div>
			<div class="editor-field editor-field--wide"><label>{label meta_title /}</label>{input meta_title}</div><div class="editor-field editor-field--wide"><label>{label meta_description /}</label>{input meta_description}</div>
			<div class="editor-field editor-field--wide"><label>{label keywords /}</label>{input keywords}</div><div class="editor-field editor-field--wide"><label>{label canonical_url /}</label>{input canonical_url}</div>
		</div></section>
		<section class="editor-group"><header><span>02</span><div><h2>Sdílení na sociálních sítích</h2><p>Informace zobrazené při sdílení stránky.</p></div></header><div class="editor-fields editor-fields--two">
			<div class="editor-field"><label>{label og_title /}</label>{input og_title}</div><div class="editor-field"><label>{label og_image /}</label>{input og_image}</div><div class="editor-field editor-field--wide"><label>{label og_description /}</label>{input og_description}</div><div class="editor-field editor-field--wide"><label>{label robots /}</label>{input robots}</div>
		</div></section>
		{elseif $editorPage === 'settings'}
		<section class="editor-group"><header><span>01</span><div><h2>Údaje společnosti</h2><p>Identifikační údaje a e-mail pro administraci.</p></div></header><div class="editor-fields editor-fields--two">
			<div class="editor-field editor-field--wide"><label>{label company_name /}</label>{input company_name}</div><div class="editor-field"><label>{label ico /}</label>{input ico}</div><div class="editor-field"><label>{label dic /}</label>{input dic}</div><div class="editor-field editor-field--wide"><label>{label admin_email /}</label>{input admin_email}</div>
		</div></section>
		<section class="editor-group"><header><span>02</span><div><h2>Sociální sítě a tlačítko</h2><p>Veřejné profily a hlavní tlačítko v horní části webu.</p></div></header><div class="editor-fields editor-fields--two">
			<div class="editor-field"><label>{label facebook /}</label>{input facebook}</div><div class="editor-field"><label>{label instagram /}</label>{input instagram}</div>			<div class="editor-field"><label>{label linkedin /}</label>{input linkedin}</div>
			<div class="editor-field"><label>{label header_cta_label /}</label>{input header_cta_label}</div><div class="editor-field"><label>{label header_cta_url /}</label>{input header_cta_url}</div>
		</div></section>
		{else}
		<section class="editor-group"><header><span>01</span><div><h2>Kontaktní údaje</h2><p>Údaje se zobrazují na webu a v patičce.</p></div></header><div class="editor-fields editor-fields--two">
			<div class="editor-field"><label>{label company_name /}</label>{input company_name}</div><div class="editor-field"><label>{label phone /}</label>{input phone}</div>
			<div class="editor-field"><label>{label email /}</label>{input email}</div><div class="editor-field"><label>{label address /}</label>{input address}</div>
			<div class="editor-field"><label>{label hours /}</label>{input hours}</div><div class="editor-field"><label>{label google_maps_url /}</label>{input google_maps_url}</div>
		</div></section>
		{/if}
		{foreach $form->getErrors() as $editorError}<p class="form-errors" role="alert">{$editorError}</p>{/foreach}<div class="site-editor-savebar">{input save}</div>
	{/form}
	</div>
	<aside class="site-editor-preview" aria-label="Náhled stránky">
		{if $editorPage === 'home'}
			<section class="editor-preview-card"><h2>Náhled úvodu</h2><img id="hero-preview" src="{$editorData['hero_image_preview']}" alt="{$editorData['hero_image_alt']}"></section>
		{elseif $editorPage === 'about'}
			<section class="editor-preview-card"><h2>Aktuální fotografie</h2><img id="about-preview" src="{$editorData['about_image_preview']}" alt="{$editorData['about_image_alt']}"><strong>{$editorData['about_title']}</strong><p>{$editorData['about_subtitle']}</p></section>
			<section class="editor-preview-card"><h2>Náhled bloku na úvodní stránce</h2><img id="home-about-preview" src="{$editorData['home_about_image_preview']}" alt="{$editorData['home_about_image_alt']}"></section>
		{elseif $editorPage === 'seo'}
			<section class="editor-preview-card editor-preview-card--seo"><h2>Ukázka výsledku ve vyhledávání</h2><strong>{$editorData['meta_title'] ?: 'Název stránky'}</strong><p class="editor-preview-card__url">tiara-stavby.cz{$editorData['seo_path']}</p><p>{$editorData['meta_description'] ?: 'Popis stránky se zobrazí ve výsledcích vyhledávání.'}</p></section>
			<section class="editor-preview-card editor-preview-card--note"><i class="fa-regular fa-circle-info" aria-hidden="true"></i><p>Úpravy SEO se týkají pouze vybrané stránky. URL vybírejte z existujících veřejných stránek.</p></section>
		{elseif $editorPage === 'settings'}
			<section class="editor-preview-card"><h2>Kontaktní profil</h2><dl><div><dt>Společnost</dt><dd>{$editorData['company_name']}</dd></div><div><dt>IČO</dt><dd>{$editorData['ico'] ?: 'Neuvedeno'}</dd></div><div><dt>DIČ</dt><dd>{$editorData['dic'] ?: 'Neuvedeno'}</dd></div><div><dt>E-mail</dt><dd>{$editorData['admin_email']}</dd></div></dl></section>
		{else}
			<section class="editor-preview-card"><h2>Kontaktní údaje</h2><dl><div><dt>Telefon</dt><dd>{$editorData['phone']}</dd></div><div><dt>E-mail</dt><dd>{$editorData['email']}</dd></div><div><dt>Adresa</dt><dd>{$editorData['address']}</dd></div><div><dt>Otevírací doba</dt><dd>{$editorData['hours']}</dd></div></dl></section>
		{/if}
	</aside>
</div>
{/block}
