{block content}
<div class="admin-page-heading"><div><p class="admin-kicker">OBSAH / TIARA CMS</p><h1>{$sectionTitle}</h1><p>Správa a publikace obsahu na veřejném webu.</p></div>{if !in_array($section, ['inquiries', 'gallery'])}<a class="admin-button" href="/admin/{$section}/create"><i class="fa-solid fa-plus"></i> Přidat záznam</a>{/if}</div>
<div class="admin-content-toolbar"><div class="admin-lang-tabs"><a href="?lang=cs" class="{if $adminLang === 'cs'}is-active{/if}">🇨🇿 Čeština</a><a href="?lang=en" class="{if $adminLang === 'en'}is-active{/if}">🇬🇧 English</a></div>{if $section === 'inquiries'}<div class="admin-filters"><a href="/admin/inquiry" class="{if !$filteredStatus}is-active{/if}">Vše</a><a href="?status=new" class="{if $filteredStatus === 'new'}is-active{/if}">Nové</a><a href="?status=contacted" class="{if $filteredStatus === 'contacted'}is-active{/if}">Kontaktováno</a><a href="?status=closed" class="{if $filteredStatus === 'closed'}is-active{/if}">Uzavřeno</a></div>{/if}</div>

{if $operation === 'delete'}
<section class="admin-panel admin-confirm"><span class="admin-confirm__icon"><i class="fa-regular fa-trash-can"></i></span><p class="admin-kicker">POTVRZENÍ AKCE</p><h2>Opravdu chcete záznam smazat?</h2><p>Tuto akci nelze vrátit zpět. Související fotografie projektu budou také odstraněny z databáze.</p>{control deleteForm}<a class="admin-text-link" href="/admin/{$section}">Zrušit a vrátit se</a></section>
{elseif $operation === 'create' || $operation === 'edit'}
<section class="admin-panel admin-form-panel"><div class="admin-panel__heading"><div><p class="admin-kicker">{if $operation === 'edit'}UPRAVIT ZÁZNAM{else}NOVÝ ZÁZNAM{/if}</p><h2>{if $operation === 'edit' && $entry}{$entry['title'] ?? $entry['name'] ?? 'Upravit záznam'}{else}Vyplňte potřebné údaje{/if}</h2></div>{if $section === 'projects' || $section === 'services'}<span class="admin-hint">CS a EN jsou samostatné jazykové záznamy.</span>{/if}</div>{if $section === 'inquiries' && $entry}<div class="inquiry-detail"><div><span>Jméno</span><strong>{$entry['name']}</strong></div><div><span>E-mail</span><a href="mailto:{$entry['email']}">{$entry['email']}</a></div><div><span>Telefon</span><a href="tel:{$entry['phone']}">{$entry['phone'] ?: '—'}</a></div><div><span>Služba</span><strong>{$entry['service'] ?: '—'}</strong></div><div><span>Datum</span><strong>{$entry['created_at']|date:'d.m.Y H:i'}</strong></div><div class="inquiry-detail__message"><span>Zpráva</span><p>{$entry['message']}</p></div></div>{/if}{control entryForm}<a class="admin-text-link" href="/admin/{$section}">← Zpět na přehled</a></section>
{else}
{if $section === 'gallery'}<section class="admin-panel gallery-upload-panel"><div class="admin-panel__heading"><div><p class="admin-kicker">NOVÁ FOTOGRAFIE</p><h2>Nahrát do galerie projektu</h2></div><span class="admin-hint">JPG, PNG, GIF nebo WebP · max. 8 MB</span></div>{control entryForm}</section>{/if}
<section class="admin-panel admin-table-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr>{if $section === 'inquiries'}<th>Klient</th><th>Kontakt</th><th>Služba</th><th>Datum</th><th>Stav</th>{elseif $section === 'projects'}<th>Projekt</th><th>Kategorie / lokalita</th><th>Jazyk</th><th>Stav</th><th>Pořadí</th>{elseif $section === 'services'}<th>Služba</th><th>URL</th><th>Jazyk</th><th>Stav</th>{elseif $section === 'pages'}<th>Sekce</th><th>Nadpis</th><th>Jazyk</th><th>Stav</th>{elseif $section === 'settings'}<th>Nastavení</th><th>Hodnota</th><th>Skupina</th>{elseif $section === 'navigation'}<th>Název</th><th>Odkaz</th><th>Jazyk</th><th>Stav</th>{elseif $section === 'seo'}<th>Stránka</th><th>Meta title</th><th>Jazyk</th><th>Robots</th>{else}<th>Fotografie</th><th>Alt text</th><th>Projekt</th><th>Pořadí</th>{/if}<th></th></tr></thead><tbody>
{foreach $rows as $row}
<tr>
{if $section === 'inquiries'}<td><strong>{$row['name']}</strong><small>{$row['email']}</small></td><td>{if $row['phone']}<a href="tel:{$row['phone']}">{$row['phone']}</a>{else}—{/if}</td><td>{$row['service'] ?: '—'}</td><td>{$row['created_at']|date:'d.m.Y'}</td><td><span class="status-pill status-pill--{$row['status']}">{$row['status']}</span></td>
{elseif $section === 'projects'}<td><strong>{$row['title']}</strong><small>{$row['year']}</small></td><td>{$row['category']}<small>{$row['location']}</small></td><td><span class="lang-pill">{strtoupper($row['lang'])}</span></td><td><span class="status-pill status-pill--{if $row['active']}active{else}inactive{/if}">{if $row['active']}Publikováno{else}Skryto{/if}{if $row['featured']} · Doporučeno{/if}</span></td><td>{$row['sort_order']}</td>
{elseif $section === 'services'}<td><strong>{$row['title']}</strong><small>{$row['short_description']|truncate:88}</small></td><td>/{$row['slug']}</td><td><span class="lang-pill">{strtoupper($row['lang'])}</span></td><td><span class="status-pill status-pill--{if $row['active']}active{else}inactive{/if}">{if $row['active']}Aktivní{else}Skryto{/if}</span></td>
{elseif $section === 'pages'}<td>{$row['section_key']}</td><td><strong>{$row['title']}</strong><small>{$row['subtitle']}</small></td><td><span class="lang-pill">{strtoupper($row['lang'])}</span></td><td><span class="status-pill status-pill--{if $row['active']}active{else}inactive{/if}">{if $row['active']}Aktivní{else}Skryto{/if}</span></td>
{elseif $section === 'settings'}<td><strong>{$row['setting_key']}</strong></td><td>{$row['setting_value']|truncate:90}</td><td>{$row['setting_group']}</td>
{elseif $section === 'navigation'}<td><strong>{$row['title']}</strong></td><td>{$row['url']}</td><td><span class="lang-pill">{strtoupper($row['lang'])}</span></td><td>{if $row['active']}Aktivní{else}Skryto{/if}</td>
{elseif $section === 'seo'}<td>{$row['page_path']}</td><td>{$row['meta_title']|truncate:80}</td><td><span class="lang-pill">{strtoupper($row['lang'])}</span></td><td>{$row['robots']}</td>
{else}<td><a href="{$row['image_path']}" target="_blank" rel="noopener"><img class="admin-table__thumb" src="{$row['image_path']}" width="72" height="54" alt=""></a></td><td>{$row['alt_text']}</td><td>#{$row['project_id']}</td><td>{$row['sort_order']}</td>{/if}
<td class="admin-row-actions"><a href="/admin/{$section}/edit/{$row['id']}" aria-label="Upravit" title="Upravit"><i class="fa-regular fa-pen-to-square"></i></a><a href="/admin/{$section}/delete/{$row['id']}" aria-label="Smazat" title="Smazat"><i class="fa-regular fa-trash-can"></i></a></td>
</tr>
{else}<tr><td colspan="7"><div class="admin-empty"><i class="fa-regular fa-folder-open"></i><strong>Zatím tu nejsou žádné záznamy.</strong>{if !in_array($section, ['inquiries', 'gallery'])}<a href="/admin/{$section}/create">Přidat první záznam</a>{/if}</div></td></tr>{/foreach}
</tbody></table></div></section>
{/if}
{/block}
