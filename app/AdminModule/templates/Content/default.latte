{block content}
{var $statusLabels = ['new' => 'Nová', 'contacted' => 'Kontaktováno', 'closed' => 'Uzavřeno']}
{var $isForm = $operation === 'create' || $operation === 'edit'}
<div class="admin-page-heading"><div><p class="admin-kicker">OBSAH / TIARA CMS</p><h1>{$sectionTitle}</h1><p>{if $isForm}{if $operation === 'edit'}Upravte údaje a uložte změny.{else}Vyplňte údaje nového záznamu a uložte je.{/if}{else}Správa a publikace obsahu na veřejném webu.{/if}</p></div>{if !$isForm && $operation !== 'delete' && $section !== 'inquiry'}{if $section === 'service'}<a class="admin-button admin-button--quiet" href="/admin/faq"><i class="fa-regular fa-circle-question"></i> Časté otázky</a>{/if}<a class="admin-button" href="/admin/{$section}/create"><i class="fa-solid fa-plus"></i> Přidat záznam</a>{/if}</div>

{if $operation === 'delete'}
<section class="admin-panel admin-confirm"><span class="admin-confirm__icon"><i class="fa-regular fa-trash-can"></i></span><p class="admin-kicker">POTVRZENÍ AKCE</p><h2>Opravdu chcete smazat „{$entry['title'] ?? $entry['name'] ?? 'záznam'}“?</h2><p>Tuto akci nelze vrátit zpět.{if $section === 'project' || $section === 'service'} Připojené fotografie budou také odstraněny.{/if}</p>{form deleteForm}{input delete}{/form}<a class="admin-text-link" href="/admin/{$section}">Zrušit a vrátit se</a></section>
{elseif $isForm}
<section class="admin-panel admin-form-panel">
	<div class="admin-panel__heading"><div><p class="admin-kicker">{if $operation === 'edit'}UPRAVIT ZÁZNAM{else}NOVÝ ZÁZNAM{/if}</p><h2>{if $operation === 'edit' && $entry}{$entry['title'] ?? $entry['name'] ?? 'Upravit záznam'}{else}Vyplňte potřebné údaje{/if}</h2></div></div>
	{if $section === 'inquiry' && $entry}<div class="inquiry-detail"><div><span>Jméno</span><strong>{$entry['name']}</strong></div><div><span>E-mail</span><a href="mailto:{$entry['email']}">{$entry['email']}</a></div><div><span>Telefon</span>{if $entry['phone']}<a href="tel:{$entry['phone']}">{$entry['phone']}</a>{else}<strong>—</strong>{/if}</div><div><span>Služba</span><strong>{$entry['service'] ?: '—'}</strong></div><div><span>Datum</span><strong>{$entry['created_at']|date:'d.m.Y H:i'}</strong></div><div class="inquiry-detail__message"><span>Zpráva</span><p>{$entry['message']}</p></div></div>{/if}
	{form entryForm}
		{foreach $form->getOwnErrors() as $formError}<p class="form-errors" role="alert">{$formError}</p>{/foreach}
		<div class="editor-fields editor-fields--two">
			{foreach $form->getControls() as $field}
				{continueIf $field instanceof Nette\Forms\Controls\HiddenField || $field instanceof Nette\Forms\Controls\SubmitButton}
				<div class="editor-field{if $field instanceof Nette\Forms\Controls\TextArea || $field instanceof Nette\Forms\Controls\UploadControl || $field instanceof Nette\Forms\Controls\Checkbox} editor-field--wide{/if}{if $field instanceof Nette\Forms\Controls\Checkbox} editor-field--check{/if}">
					{if $field instanceof Nette\Forms\Controls\Checkbox}{input $field}
					{else}
						{label $field /}{input $field}
						{if $field instanceof Nette\Forms\Controls\UploadControl}
							{if $currentImage}<img class="admin-current-image" src="{$imageManager->safeUrl($currentImage)}" alt="Aktuální fotografie"><small>Aktuální fotografie. Nahráním nové ji nahradíte. JPG, PNG, GIF nebo WebP, maximálně 8 MB.</small>{else}<small>JPG, PNG, GIF nebo WebP, maximálně 8 MB.</small>{/if}
						{/if}
					{/if}
					{if $field->hasErrors()}<small class="field-error" role="alert">{$field->getError()}</small>{/if}
				</div>
			{/foreach}
		</div>
		<div class="admin-form-actions">{input save}<a class="admin-button admin-button--quiet" href="/admin/{$section}">Zrušit</a></div>
	{/form}
</section>
{else}
{if $section === 'inquiry'}<div class="admin-content-toolbar"><div class="admin-filters"><a href="/admin/inquiry" class="{if !$filteredStatus}is-active{/if}">Vše</a><a href="?status=new" class="{if $filteredStatus === 'new'}is-active{/if}">Nové</a><a href="?status=contacted" class="{if $filteredStatus === 'contacted'}is-active{/if}">Kontaktováno</a><a href="?status=closed" class="{if $filteredStatus === 'closed'}is-active{/if}">Uzavřeno</a></div></div>{/if}
<section class="admin-panel admin-table-panel"><div class="admin-table-wrap"><table class="admin-table"><thead><tr>{if $section === 'inquiry'}<th>Klient</th><th>Kontakt</th><th>Služba</th><th>Datum</th><th>Stav</th>{elseif $section === 'project'}<th>Realizace</th><th>Kategorie / lokalita</th><th>Stav</th><th>Pořadí</th>{elseif $section === 'service'}<th>Služba</th><th>URL</th><th>Stav</th><th>Pořadí</th>{elseif $section === 'faq'}<th>Otázka</th><th>Odpověď</th><th>Stav</th><th>Pořadí</th>{elseif $section === 'navigation'}<th>Název</th><th>Odkaz</th><th>Stav</th><th>Pořadí</th>{/if}<th><span class="visually-hidden">Akce</span></th></tr></thead><tbody>
{foreach $rows as $row}
<tr>
{if $section === 'inquiry'}<td data-label="Klient"><strong>{$row['name']}</strong><small>{$row['email']}</small></td><td data-label="Kontakt">{if $row['phone']}<a href="tel:{$row['phone']}">{$row['phone']}</a>{else}—{/if}</td><td data-label="Služba">{$row['service'] ?: '—'}</td><td data-label="Datum">{$row['created_at']|date:'d.m.Y'}</td><td data-label="Stav"><span class="status-pill status-pill--{$row['status']}">{$statusLabels[$row['status']] ?? $row['status']}</span></td>
{elseif $section === 'project'}<td data-label="Realizace"><strong>{$row['title']}</strong><small>{$row['year']}</small></td><td data-label="Kategorie">{$row['category']}<small>{$row['location']}</small></td><td data-label="Stav"><span class="status-pill status-pill--{if $row['active']}active{else}inactive{/if}">{if $row['active']}Zveřejněno{else}Skryto{/if}{if $row['featured']} · Doporučeno{/if}</span></td><td data-label="Pořadí">{$row['sort_order']}</td>
{elseif $section === 'service'}<td data-label="Služba"><strong>{$row['title']}</strong><small>{$row['short_description']|truncate:88}</small></td><td data-label="URL">/{$row['slug']}</td><td data-label="Stav"><span class="status-pill status-pill--{if $row['active']}active{else}inactive{/if}">{if $row['active']}Zveřejněno{else}Skryto{/if}</span></td><td data-label="Pořadí">{$row['sort_order']}</td>
{elseif $section === 'faq'}<td data-label="Otázka"><strong>{$row['question']}</strong></td><td data-label="Odpověď"><small>{$row['answer']|truncate:120}</small></td><td data-label="Stav"><span class="status-pill status-pill--{if $row['active']}active{else}inactive{/if}">{if $row['active']}Zveřejněno{else}Skryto{/if}</span></td><td data-label="Pořadí">{$row['sort_order']}</td>
{elseif $section === 'navigation'}<td data-label="Název"><strong>{$row['title']}</strong></td><td data-label="Odkaz">{$row['url']}</td><td data-label="Stav"><span class="status-pill status-pill--{if $row['active']}active{else}inactive{/if}">{if $row['active']}Zobrazeno{else}Skryto{/if}</span></td><td data-label="Pořadí">{$row['sort_order']}</td>
{/if}
<td class="admin-row-actions"><a href="/admin/{$section}/edit/{$row['id']}" title="{if $section === 'inquiry'}Detail{else}Upravit{/if}"><i class="fa-regular fa-pen-to-square"></i> <span>{if $section === 'inquiry'}Detail{else}Upravit{/if}</span></a><a href="/admin/{$section}/delete/{$row['id']}" title="Smazat"><i class="fa-regular fa-trash-can"></i> <span>Smazat</span></a></td>
</tr>
{else}<tr><td colspan="5"><div class="admin-empty"><i class="fa-regular fa-folder-open"></i><strong>Zatím tu nejsou žádné záznamy.</strong>{if $section !== 'inquiry'}<a href="/admin/{$section}/create">Přidat první záznam</a>{/if}</div></td></tr>{/foreach}
</tbody></table></div></section>
{/if}
{/block}
