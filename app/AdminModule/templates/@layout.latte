<!doctype html>
<html lang="cs">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{ifset $pageTitle}{$pageTitle} · {/ifset}TIARA CMS</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"><link rel="stylesheet" href="/css/admin.css"></head>
<body class="admin-shell">
	{ifset $adminUser}
	<div class="admin-frame">
		<div class="admin-backdrop" hidden></div>
		<aside class="admin-sidebar" id="admin-sidebar"><a class="admin-brand" href="/admin"><img src="/images/tiara-logo-light.svg" width="180" height="54" alt="TIARA s.r.o."></a>
			<nav aria-label="Navigace administrace"><span class="admin-nav__label">PŘEHLED</span><a href="/admin" class="{if $presenter->getName() === 'Admin:Dashboard'}is-active{/if}"><i class="fa-solid fa-table-cells-large"></i> Nástěnka</a><span class="admin-nav__label">STRÁNKY WEBU</span><a href="/admin/editor/home" class="{if $presenter->getName() === 'Admin:SiteEditor' && $presenter->getParameter('page') === 'home'}is-active{/if}"><i class="fa-solid fa-house"></i> Úvodní stránka</a><a href="/admin/editor/about" class="{if $presenter->getName() === 'Admin:SiteEditor' && $presenter->getParameter('page') === 'about'}is-active{/if}"><i class="fa-regular fa-building"></i> O nás</a><a href="/admin/service" class="{if $presenter->getName() === 'Admin:Content' && $presenter->getParameter('section') === 'service'}is-active{/if}"><i class="fa-solid fa-compass-drafting"></i> Služby</a><a href="/admin/faq" class="{if $presenter->getName() === 'Admin:Content' && $presenter->getParameter('section') === 'faq'}is-active{/if}"><i class="fa-regular fa-circle-question"></i> Časté otázky</a><a href="/admin/project" class="{if $presenter->getName() === 'Admin:Content' && $presenter->getParameter('section') === 'project'}is-active{/if}"><i class="fa-solid fa-helmet-safety"></i> Realizace</a><a href="/admin/editor/contact" class="{if $presenter->getName() === 'Admin:SiteEditor' && $presenter->getParameter('page') === 'contact'}is-active{/if}"><i class="fa-regular fa-address-card"></i> Kontakt</a><span class="admin-nav__label">KOMUNIKACE</span><a href="/admin/inquiry" class="{if $presenter->getName() === 'Admin:Content' && $presenter->getParameter('section') === 'inquiry'}is-active{/if}"><i class="fa-regular fa-message"></i> Poptávky</a><span class="admin-nav__label">NASTAVENÍ</span><a href="/admin/navigation" class="{if $presenter->getName() === 'Admin:Content' && $presenter->getParameter('section') === 'navigation'}is-active{/if}"><i class="fa-solid fa-bars"></i> Navigace</a><a href="/admin/editor/seo" class="{if $presenter->getName() === 'Admin:SiteEditor' && $presenter->getParameter('page') === 'seo'}is-active{/if}"><i class="fa-solid fa-magnifying-glass"></i> SEO</a><a href="/admin/editor/settings" class="{if $presenter->getName() === 'Admin:SiteEditor' && $presenter->getParameter('page') === 'settings'}is-active{/if}"><i class="fa-solid fa-sliders"></i> Nastavení webu</a></nav>
			<div class="admin-sidebar__bottom"><a href="/" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square"></i> Zobrazit web</a>{form logoutForm}{input logout}{/form}</div>
		</aside>
		<div class="admin-main"><header class="admin-topbar"><button class="admin-menu-toggle" type="button" aria-label="Menu" aria-controls="admin-sidebar" aria-expanded="false"><i class="fa-solid fa-bars"></i></button><div><span class="admin-topbar__eyebrow">TIARA s.r.o.</span><strong>Správa obsahu</strong></div><div class="admin-topbar__right"><span class="admin-user"><i class="fa-regular fa-circle-user"></i> {$adminUser}</span></div></header>
			{foreach $flashes as $flash}<div class="admin-flash admin-flash--{$flash->type}">{$flash->message}</div>{/foreach}
			<main class="admin-content">{include content}</main><footer class="admin-footer">TIARA s.r.o. <span>·</span> Správa obsahu <span>·</span> 2026</footer></div>
	</div>
	{else}{include content}{/ifset}
	<script src="/js/admin.js" defer></script>
</body>
</html>
