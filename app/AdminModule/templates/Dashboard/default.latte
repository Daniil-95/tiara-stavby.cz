{block content}
<div class="admin-page-heading"><div><p class="admin-kicker">PONDĚLÍ · TIARA s.r.o.</p><h1>Dashboard</h1><p>Vítejte zpět, {$adminUser}. Tady je přehled vašeho webu.</p></div><a class="admin-button" href="/admin/project/create"><i class="fa-solid fa-plus"></i> Přidat realizaci</a></div>
<div class="dashboard-metrics"><a class="metric-card" href="/admin/project"><span>Aktivní realizace</span><strong>{$projectCount}</strong><small>napříč oběma jazyky</small><i class="fa-regular fa-building"></i></a><a class="metric-card" href="/admin/service"><span>Aktivní služby</span><strong>{$serviceCount}</strong><small>CS + EN</small><i class="fa-solid fa-compass-drafting"></i></a><a class="metric-card metric-card--accent" href="/admin/inquiry"><span>Nové poptávky</span><strong>{$newInquiries}</strong><small>čekají na vyřízení</small><i class="fa-regular fa-message"></i></a></div>
<div class="dashboard-columns"><section class="admin-panel"><div class="admin-panel__heading"><div><p class="admin-kicker">OBSAH WEBU</p><h2>Poslední realizace</h2></div><a href="/admin/project">Všechny <i class="fa-solid fa-arrow-right"></i></a></div>{if count($latestProjects)}<div class="dashboard-list">{foreach $latestProjects as $project}<a href="/admin/project/edit/{$project->id}"><span class="dashboard-list__thumb"><img src="{$project->main_image ?: '/images/project-fallback.svg'}" width="72" height="60" alt=""></span><span class="dashboard-list__text"><strong>{$project->title}</strong><small>{$project->category} · {$project->location}</small></span><span class="dashboard-list__lang">{strtoupper($project->lang)}</span></a>{/foreach}</div>{else}<div class="admin-empty"><i class="fa-regular fa-folder-open"></i><p>Zatím tu nejsou žádné realizace.</p><a href="/admin/project/create">Přidat první</a></div>{/if}</section>
<section class="admin-panel"><div class="admin-panel__heading"><div><p class="admin-kicker">KOMUNIKACE</p><h2>Poslední poptávky</h2></div><a href="/admin/inquiry">Všechny <i class="fa-solid fa-arrow-right"></i></a></div>{if count($latestInquiries)}<div class="dashboard-list">{foreach $latestInquiries as $inquiry}<a href="/admin/inquiry/edit/{$inquiry->id}"><span class="inquiry-initial">{substr($inquiry->name, 0, 1)|upper}</span><span class="dashboard-list__text"><strong>{$inquiry->name}</strong><small>{$inquiry->email} · {$inquiry->created_at|date:'d.m.Y'}</small></span><span class="status-pill status-pill--{$inquiry->status}">{$inquiry->status}</span></a>{/foreach}</div>{else}<div class="admin-empty"><i class="fa-regular fa-envelope-open"></i><p>Zatím žádné poptávky.</p></div>{/if}</section></div>
<div class="admin-quick-actions"><span>RYCHLÉ AKCE</span><a href="/admin/service/create"><i class="fa-solid fa-plus"></i> Nová služba</a><a href="/admin/page"><i class="fa-regular fa-file-lines"></i> Upravit obsah stránky</a><a href="/admin/setting"><i class="fa-solid fa-sliders"></i> Nastavení webu</a></div>
{/block}
