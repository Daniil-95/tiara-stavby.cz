# Copy this file to production.neon on the hosting and replace every value.
# Keep production.neon outside version control.
parameters:
	adminEmail: info@tiara-stavby.cz
	baseUrl: https://tiara-stavby.cz

database:
	dsn: 'mysql:host=127.0.0.1;dbname=replace_with_production_database;charset=utf8mb4'
	user: replace_with_restricted_database_user
	password: replace_with_strong_database_password
	options:
		PDO::ATTR_ERRMODE: PDO::ERRMODE_EXCEPTION
		PDO::ATTR_DEFAULT_FETCH_MODE: PDO::FETCH_ASSOC
		PDO::MYSQL_ATTR_INIT_COMMAND: "SET NAMES utf8mb4, sql_mode='STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION'"
